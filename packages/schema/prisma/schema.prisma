// Guardian data model.
//
// Two rules shape every table here. Every stored row carries a customerId and a
// retentionClass, and deletion is a scheduled job rather than a hope
// (CLAUDE.md rule 7). Customer user ids are stored only as per-customer salted
// hashes, so nothing joins across customers without the customer's key
// (CLAUDE.md rule 8).
//
// There is no column anywhere for image or video bytes. Media appears only as a
// sha256 and the operator's own scanner verdict (CLAUDE.md rule 1).
//
// A third set of columns is compliance evidence rather than metadata: where an
// age band came from and how sure the source was, whether a person read a given
// excerpt, the customer's jurisdiction and legal basis, whether a channel was
// private, whether the actor score alone stood behind a tier, and who wrote a
// piece of feedback. None of them can be added honestly after thresholds are
// tuned against live traffic, so they exist before the first customer does.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Six bands matching Roblox's scheme, plus unknown. Never a birthdate.
enum AgeBand {
  UNDER_9
  A9_12
  A13_15
  A16_17
  A18_20
  A21_PLUS
  UNKNOWN
}

/// Where a band came from. A band read off a Discord role is not the same
/// claim as one from an identity document, and the UK Online Safety Act's
/// highly effective age assurance test turns on that difference. There is no
/// column for the four statutory brackets: they are derived from the band by
/// statutoryBracket() so the mapping lives in one place.
enum AgeBandProvenance {
  facial_estimate
  government_id
  os_bracket
  server_role
  platform_default
  customer_declared
  unknown
}

/// Whether the operator should be handed friction or a welfare route (ROADMAP
/// S4). The account a tier describes is sometimes the one being coerced, and
/// Patchin and Hinduja (n=5,568) found perpetrators are disproportionately
/// former victims. Nullable: a row written before fusion emitted a posture has
/// no honest value, and absent does not mean enforcement.
enum SuggestedPosture {
  enforcement
  support
}

/// Under whose authority Guardian processes a customer's traffic. Nullable on
/// the customer on purpose: an unset basis is visibly unset rather than a claim
/// nobody made.
enum LegalBasis {
  provider_2258a
  processor
  parental_consent
  operator_authority
}

/// Regulation (EU) 2026/1881, in force 31 July 2026 to 3 April 2028, treats
/// private messaging differently from open channels. Null means the customer
/// did not say, and the code reads that as private.
enum ChannelVisibility {
  public
  private
  group
}

/// Who wrote a piece of feedback that can reach the lexicon mining loop. The
/// dismissal control on the mod-channel card is a write path open to anyone
/// with moderator permissions in the guild, so the writer is recorded.
enum FeedbackSource {
  reviewer
  moderator
  automated
  unknown
}

enum Tier {
  T0
  T1
  T2
  T3
}

enum RetentionClass {
  EPHEMERAL_24H
  WATCH_30D
  CASE_1Y
  LEGAL_HOLD
}

enum Stage {
  none
  contact
  trust
  probe
  migrate
  sexualize
  coerce
}

enum ActorRole {
  member
  moderator
  trusted_adult
  unknown
}

enum Surface {
  discord
  platform_sdk
  parent_app
  investigator
}

enum ReviewDecision {
  dismiss
  watch
  confirm
  report
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  /// sha256 of the API key. The key itself is shown once, at creation.
  apiKeyHash String  @unique
  /// Hex salt for hashing this customer's user ids. Never leaves the process.
  idSalt    String
  /// Shared secret for signing webhooks in both directions.
  webhookSecret String
  webhookUrl    String?
  /// Lantern-style cross-customer sharing is opt-in and off by default.
  crossCustomerOptIn Boolean @default(false)
  /// Per-customer lexicon extension, merged over the base at load.
  lexiconExtension   Json?
  /// ISO 3166-1 alpha-2, and the ISO 3166-2 subdivision suffix on its own
  /// ("TX", not "US-TX") when a state rule applies. Over a tenth of industry
  /// CyberTipline reports in 2025 lacked enough data to determine jurisdiction.
  jurisdictionCountry     String?
  jurisdictionSubdivision String?
  /// Null until counsel or the operator agreement settles it.
  legalBasis LegalBasis?
  createdAt DateTime @default(now())

  actors  Actor[]
  events  Event[]
  pairs   Pair[]
  bundles EvidenceBundle[]
  violations CustomerViolation[]

  @@map("customers")
}

model Actor {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Salted hash of the customer's user id.
  hashedUid  String
  ageBand    AgeBand  @default(UNKNOWN)
  /// 0 to 1. Null means the source published no calibrated number, which is
  /// not the same as a low one, so nothing may read null as zero.
  ageBandConfidence Float?
  ageBandProvenance AgeBandProvenance @default(unknown)
  role       ActorRole @default(unknown)
  accountAgeHours Float?
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())
  /// Recency-weighted fraction of recent messages carrying a flagged pattern.
  skewScore  Float    @default(0)
  fanOut7d   Int      @default(0)
  minorFanOut7d Int   @default(0)
  /// Rolling daily counters and contact sets. Trimmed to 30 days by the retention job.
  graphState Json?
  /// Hashed device and network hints, for alt clustering within one customer.
  hints      String[] @default([])
  /// Set when the operator actions this account. Feeds alt clustering.
  actionedAt DateTime?
  retention  RetentionClass @default(WATCH_30D)
  expiresAt  DateTime?

  @@unique([customerId, hashedUid])
  @@index([customerId, expiresAt])
  @@map("actors")
}

model Event {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// The customer's own message id. Idempotency key within a customer.
  externalId String
  actorUid   String
  targetUid  String?
  channel    String
  ts         DateTime
  /// Dropped by the retention job for T0 pairs within 24h (DESIGN.md 7).
  text       String?
  /// sha256 only. There is no column for bytes.
  mediaSha256 String?
  knownCsamVerdict String?
  actorBand  AgeBand  @default(UNKNOWN)
  targetBand AgeBand  @default(UNKNOWN)
  /// The band as captured at event time, with how it was arrived at and how
  /// sure the source was. Bands move: Roblox regrouped accounts into three
  /// tiers in June 2026. The score that was assigned has to stay explainable
  /// against the band that was known then.
  actorBandConfidence  Float?
  actorBandProvenance  AgeBandProvenance @default(unknown)
  targetBandConfidence Float?
  targetBandProvenance AgeBandProvenance @default(unknown)
  /// Null means the customer did not say. Read as private by
  /// treatAsPrivateMessaging, so the stricter rule applies by default.
  channelVisibility ChannelVisibility?
  actorRole  ActorRole @default(unknown)
  features   Json?
  stageProbs Json?
  stage      Stage?
  surface    Surface
  sourceId   String
  modelVersion   String?
  lexiconVersion String?
  fusionVersion  String?
  retention  RetentionClass @default(EPHEMERAL_24H)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([customerId, externalId])
  @@index([customerId, actorUid, ts])
  @@index([customerId, targetUid, ts])
  @@index([expiresAt])
  @@map("events")
}

/// Pairs carry their own retention class, so nothing above them may cascade a
/// delete into this table. There is deliberately no foreign key to actors: an
/// actor row expires on its own 30 day clock and a pair under CASE_1Y or a legal
/// hold must outlive it. The customer relation is Restrict for the same reason.
model Pair {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Salted hashes. Matched to actors by (customerId, hashedUid) in code.
  actorUid   String
  targetUid  String
  /// First time each stage was reached, in event time. Order is the signal.
  firstStageAt Json
  /// Gated signal hits kept for the evidence bundle. Capped.
  signals    Json
  pairScore  Float    @default(0)
  actorScore Float    @default(0)
  fusedScore Float    @default(0)
  tier       Tier     @default(T0)
  /// Set when a critical signal forced the tier, so a reviewer sees why.
  criticalSignals String[] @default([])
  /// True when the per-actor score alone stood behind the tier, with no
  /// conversational fact on the pair. Article 5(1)(d) of Regulation (EU)
  /// 2024/1689 prohibits assessing the likelihood of a person offending from
  /// profiling alone, and its carve-out is support for human assessment
  /// grounded in facts tied to the conversation. The row answers that, not a
  /// later reading of the fusion code. Computed by isActorScoreSoleBasis().
  soleAutomatedBasis Boolean @default(false)
  /// Enforcement or support, as fusion emitted it. Read by the Discord bot,
  /// which withholds the automatic timeout under support, and by the reviewer
  /// queue. Stored rather than recomputed because the bands it derives from are
  /// not on this row.
  suggestedPosture SuggestedPosture?
  /// Per-excerpt human-viewed flags live in the signals json, one per hit.
  /// This is the pair-level anchor: when a person first read anything here.
  humanViewedAt DateTime?
  messageCounts   Json?
  lastInboundMediaAt DateTime?
  windowStart DateTime?
  windowEnd   DateTime?
  modelVersion   String?
  lexiconVersion String?
  fusionVersion  String?
  retention  RetentionClass @default(EPHEMERAL_24H)
  expiresAt  DateTime?
  /// Set when a reviewer takes the pair off the queue.
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reviews Review[]
  bundles EvidenceBundle[]

  @@unique([customerId, actorUid, targetUid])
  @@index([customerId, tier, updatedAt])
  @@index([expiresAt])
  @@map("pairs")
}

/// A human decision. This is the only thing that can produce T3
/// (CLAUDE.md rule 6). The model writes Pair.tier and never Review.
model Review {
  id         String   @id @default(cuid())
  pairId     String
  /// Restrict: a reviewer's decision is never removed by a pair expiring.
  pair       Pair     @relation(fields: [pairId], references: [id], onDelete: Restrict)
  reviewerId String
  decision   ReviewDecision
  /// Free text from the reviewer. Feeds the learned fusion model in phase 2.
  reason     String?
  /// Tier the model had assigned when the reviewer opened the case.
  modelTier  Tier
  /// Tier after the decision. Only a confirm or report may set T3.
  resultTier Tier
  /// Minutes the reviewer spent. Reviewer minutes per 1,000 users is a
  /// first-class metric (DESIGN.md 6.4).
  minutesSpent Float?
  /// Who produced this decision. A dismissal from the mod-channel card and one
  /// from the review console feed the lexicon loop with very different weight,
  /// and the guild control is reachable by any moderator. Defaults to unknown
  /// so an unattributed write is visible rather than credited to a reviewer.
  feedbackSource FeedbackSource @default(unknown)
  /// How many timeline excerpts this reviewer marked as read. The per-excerpt
  /// flags live on the bundle timeline json; this is the count for the queue.
  viewedExcerptCount Int?
  createdAt  DateTime @default(now())

  @@index([pairId, createdAt])
  @@index([reviewerId, createdAt])
  @@map("reviews")
}

/// Text excerpts, hashes, timestamps and model versions. No imagery, ever.
model EvidenceBundle {
  id         String   @id @default(cuid())
  bundleId   String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pairId     String?
  pair       Pair?    @relation(fields: [pairId], references: [id], onDelete: SetNull)
  actorUid   String
  targetUid  String
  tier       Tier
  /// Each timeline row and each signal hit carries its own viewedByHuman flag,
  /// false until a reviewer action sets it. NCMEC report quality turns on
  /// whether a person read the material, and so does the private-search
  /// question, so the answer is per excerpt rather than per case.
  timeline   Json
  signals    Json
  provenance Json
  /// When a person first read any excerpt in this bundle, and who. Null on a
  /// bundle the model produced and nobody has opened.
  humanViewedAt DateTime?
  humanViewedByReviewerId String?
  /// Copied from the customer at generation time so the export carries its own
  /// jurisdiction and authority rather than depending on a later join.
  jurisdictionCountry     String?
  jurisdictionSubdivision String?
  legalBasis LegalBasis?
  modelVersion   String
  lexiconVersion String
  fusionVersion  String
  /// Hash chain head at generation time, anchoring the bundle to the log.
  auditHead  String
  retention  RetentionClass @default(WATCH_30D)
  expiresAt  DateTime?
  generatedAt DateTime @default(now())

  report CyberTiplineReport?

  @@index([customerId, tier, generatedAt])
  @@map("evidence_bundles")
}

/// One reporting path: NCMEC CyberTipline (CLAUDE.md rule 4). Phase 3.
model CyberTiplineReport {
  id         String   @id @default(cuid())
  bundleId   String   @unique
  /// Restrict: the bundle is under a one year preservation duty once a report
  /// exists (18 USC 2258A). The retention sweep skips bundles with a report.
  bundle     EvidenceBundle @relation(fields: [bundleId], references: [bundleId], onDelete: Restrict)
  customerId String
  /// The customer is the 2258A provider and the reporter of record.
  reporterCustomerId String
  /// Report id returned by the ESP API, or null for a drafted public-form bundle.
  ncmecReportId String?
  status     String   @default("draft")
  submittedAt DateTime?
  /// 18 USC 2258A: one year from submission.
  preserveUntil DateTime?
  retention  RetentionClass @default(CASE_1Y)
  createdAt  DateTime @default(now())

  @@index([customerId, status])
  @@map("cybertipline_reports")
}

/// Hash-chained append-only log. Every score, reviewer action and export.
///
/// seq is assigned by the application under an advisory lock (packages/audit),
/// not by a sequence. customerId is a plain column: the sweep writes as
/// "system", a pre-auth refusal as "unknown", and a foreign key with ON UPDATE
/// CASCADE would rewrite a column the hash covers. The unique constraints on
/// prevHash and hash make a fork of the chain a database error.
model AuditEntry {
  seq        Int      @id
  ts         DateTime @default(now())
  kind       String
  customerId String
  payload    Json
  prevHash   String   @unique
  hash       String   @unique

  @@index([customerId, seq])
  @@index([kind, ts])
  @@map("audit_entries")
}

/// A customer sent something the edge refused, most often media bytes. Recorded
/// against the customer, never against a user, and never with the content.
model CustomerViolation {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason     String
  path       String
  detail     String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
  @@map("customer_violations")
}

/// Per-guild configuration for the Discord surface. Scoring is off until the
/// owner names a mod channel and enables it.
///
/// The key is (guildId, customerId), not the guild alone. Two deployments can
/// share a database and both be present in one guild; each owns its own row,
/// and neither can take over the other's by writing on the guild id (rule 8).
model GuildConfig {
  guildId    String
  customerId String
  modChannelId String?
  roleBands  Json     @default("{}")
  trustedRoleIds String[] @default([])
  defaultBand AgeBand @default(A13_15)
  /// Bands read off guild roles are server_role by construction. This records
  /// where the fallback band came from, which is the honest answer to an age
  /// assurance question about a Discord deployment.
  defaultBandProvenance AgeBandProvenance @default(platform_default)
  autoTimeoutOnT2 Boolean @default(false)
  autoTimeoutMinutes Int  @default(60)
  excludedChannelIds String[] @default([])
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([guildId, customerId])
  @@index([customerId])
  @@map("guild_configs")
}
